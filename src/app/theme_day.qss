/* 日间主题 浅灰白底 蓝色强调 */
QMainWindow, QWidget {
    background: #f4f5f7;
    color: #2b2f36;
    font-family: "Microsoft YaHei";
}
QToolBar {
    background: #e8eaee;
    border-bottom: 1px solid #d0d3da;
    spacing: 6px;
    padding: 4px;
}
QToolBar QToolButton, QPushButton {
    background: #ffffff;
    color: #2b2f36;
    border: 1px solid #c6cad2;
    border-radius: 4px;
    padding: 5px 14px;
}
QToolBar QToolButton:hover, QPushButton:hover {
    background: #eef4fb;
    border-color: #1976d2;
}
QToolBar QToolButton:pressed, QPushButton:pressed {
    background: #dde6f2;
}
/* 勾选态 仅线框与操作器按钮 蓝色高亮边框+淡蓝底 */
#wireBtn:checked, #transformBtn:checked {
    background: #dcecfc;
    border: 1px solid #1976d2;
    color: #0d5fa8;
}
/* 投影按钮勾选不改变外观 无按下态效果 */
#projBtn:checked {
    background: #ffffff;
    border: 1px solid #c6cad2;
    color: #2b2f36;
}
/* 禁用按钮文字浅灰 日间亮底减淡 */
QToolBar QToolButton:disabled, QPushButton:disabled {
    color: #aab0b8;
    background: #eef0f3;
    border-color: #d8dbe0;
}
QStatusBar {
    background: #e8eaee;
    border-top: 1px solid #d0d3da;
    color: #5a6068;
}
QMenuBar {
    background: #e8eaee;
    color: #2b2f36;
}
QMenuBar::item:selected, QMenu::item:selected {
    background: #dde6f2;
}
QMenu {
    background: #ffffff;
    color: #2b2f36;
    border: 1px solid #c6cad2;
}
QToolTip {
    background: #ffffff;
    color: #2b2f36;
    border: 1px solid #1976d2;
}
